--ANCHORED DATATYPE -%TYPR

DECLARE 
E_NAME HR.EMPLOYEES.FIRST_NAME%TYPE;         
E_SALARY HR.EMPLOYEES.SALARY%TYPE;

BEGIN 
    SELECT FIRST_NAME, SALARY INTO E_NAME, E_SALARY FROM HR.EMPLOYEES
    WHERE EMPLOYEE_ID = 100;
    DBMS_OUTPUT.PUT_LINE(E_NAME || ' has Salary ' || E_SALARY);

END;
