DECLARE
v_name VARCHAR(20) := 'Rutuja';  
v_salary NUMBER := '50000';
c_Bonus CONSTANT NUMBER := '20000';

BEGIN
    DBMS_OUTPUT.PUT_LINE(v_name);
    DBMS_OUTPUT.PUT_LINE(v_salary);
    DBMS_OUTPUT.PUT_LINE(v_salary + c_bonus);

    --OR If WE want to combine multiple values then use Pipesign - ||
    DBMS_OUTPUT.PUT_LINE(' Salary of ' || v_name || ' is ' || v_salary || ' and Bonus is ' || c_Bonus);
END;
