-- Q1. Display all employees.'
SELECT * FROM employees;

-- Q2. Display employee ID, first name and salary.
SELECT employee_id,
       first_name,
       salary
FROM employees;


--Q3. Display all departments.
SELECT * FROM departments;


--Q4. Display employee ID and email.
SELECT employee_id,
       email
FROM employees;


--Q5. Display unique department IDs.
SELECT DISTINCT department_id FROM employees;


--Q6. Display unique job IDs.
SELECT DISTINCT job_id FROM employees;


--Q7. Display employee name and annual salary.
SELECT first_name,
       salary * 12 AS annual_salary
FROM employees;


--Q8. Display employee name and annual salary including a 10% bonus.
SELECT first_name,
       salary * 12 AS annual_salary,
       salary * 12 * 1.10 AS salary_with_bonus
FROM employees;