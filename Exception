--Question: Raise an exception if an employee's salary is below 30,000.

DECLARE
    v_salary employees.salary%TYPE;

    e_low_salary EXCEPTION;

BEGIN
    SELECT salary
    INTO v_salary
    FROM employees
    WHERE employee_id = 101;

    IF v_salary < 30000 THEN
        RAISE e_low_salary;
    END IF;

    DBMS_OUTPUT.PUT_LINE(
        'Salary is within the acceptable range.'
    );

EXCEPTION
    WHEN e_low_salary THEN
        DBMS_OUTPUT.PUT_LINE(
            'Error: Employee salary is below the minimum limit.'
        );

    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE(
            'Error: Employee not found.'
        );
END;
/