-- Table creation in PLSQL

DECLARE
    message VARCHAR2(100) := 'Table created';
BEGIN
    EXECUTE IMMEDIATE '
        CREATE TABLE Employees (
            emp_Id NUMBER PRIMARY KEY,
            emp_Name VARCHAR2(50),
            Department VARCHAR2(50),
            Salary NUMBER
        )';

    DBMS_OUTPUT.PUT_LINE(message);
END;
