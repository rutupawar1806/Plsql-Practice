/*SELECT, FROM,WHERE, GROUP BY, HAVING, ORDER BY

Common operators: =, >, <, >=, <=, <>, !=

BETWEEN, IN, LIKE, IS NULL, IS NOT NULL, AND, OR, NOT*/


--Q1. Find employees earning more than 5000.
SELECT employee_id,
       first_name,
       salary
FROM employees
WHERE salary > 5000;


--Q2. Find employees earning less than 5000.
SELECT employee_id,
       first_name,
       salary
FROM employees
WHERE salary < 5000;


--Q3. Find employees earning exactly 5000.
SELECT employee_id,
       first_name,
       salary
FROM employees
WHERE salary = 5000;


--Q4. Find employees earning between 3000 and 7000.
SELECT employee_id,
       first_name,
       salary
FROM employees
WHERE salary BETWEEN 3000 AND 7000;


--Q5. Find employees working in departments IT, HR
SELECT employee_id,
       first_name,
       department_id
FROM employees
WHERE department_id IN (IT, HR);


--Q6. Find employees whose first name starts with A.
SELECT employee_id,
       first_name
FROM employees
WHERE first_name LIKE 'A%';


--Q7. Find employees whose first name ends with n.
SELECT employee_id,
       first_name
FROM employees
WHERE first_name LIKE '%n';


--Q8. Find employees whose name contains 'an'.
SELECT employee_id,
       first_name
FROM employees
WHERE first_name LIKE '%an%';


--Q9. Find employees whose first name has exactly five characters.
SELECT employee_id,
       first_name
FROM employees
WHERE first_name LIKE '_____';


--Q10. Find employees with no Department.
SELECT employee_id,
       first_name,
       manager_id
FROM employees
WHERE manager_id IS NULL;


--Q11. Find employees who have a manager.
SELECT employee_id,
       first_name,
       manager_id
FROM employees
WHERE manager_id IS NOT NULL;


-- Q12. Find employees earning more than 5000 in department 20.
SELECT employee_id,
       first_name,
       salary
FROM employees
WHERE salary > 5000
AND department_id = 20;


--Q13. Find employees earning more than 10000 OR working in department 10.
SELECT employee_id,
       first_name,
       salary,
       department_id
FROM employees
WHERE salary > 10000
   OR department_id = 10;


--Q14. Display employees sorted by salary ascending.
SELECT employee_id,
       first_name,
       salary
FROM employees
ORDER BY salary ASC;


--Q15. Display employees sorted by salary descending.
SELECT employee_id,
       first_name,
       salary
FROM employees
ORDER BY salary DESC;


--Q16. Sort employees by department and then salary descending.
SELECT employee_id,
       first_name,
       department_id,
       salary
FROM employees
ORDER BY department_id,
         salary DESC;


--Q17. Display the five highest-paid employees.
SELECT employee_id,
       first_name,
       salary
FROM employees
ORDER BY salary DESC
FETCH FIRST 5 ROWS ONLY;


--Q18. Display the five lowest-paid employees.
SELECT employee_id,
       first_name,
       salary
FROM employees
ORDER BY salary ASC
FETCH FIRST 5 ROWS ONLY;